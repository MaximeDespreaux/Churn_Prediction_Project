# Text files: let Git detect them, store and check them out with LF on every OS
# (make, Docker, shells and the YAML/TOML parsers all expect LF).
* text=auto eol=lf

# Binary: never normalise or diff
*.parquet   binary
*.joblib    binary
*.pkl       binary
*.png       binary

# Generated by `uv lock`: collapsed in GitHub diffs
uv.lock     linguist-generated=true
